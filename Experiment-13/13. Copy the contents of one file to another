#include <iostream>
#include <fstream>
using namespace std;

int main()
{
    // Create a source file and write some text into it
    ofstream createFile("source.txt");
    createFile << "Welcome to C++ File Handling." << endl;
    createFile << "This is the source file.";
    createFile.close();

    string sourceFile, destinationFile;

    cout << "Enter source file name: ";
    cin >> sourceFile;

    cout << "Enter destination file name: ";
    cin >> destinationFile;

    // Open source file for reading
    ifstream source(sourceFile);

    if (!source)
    {
        cout << "Error opening source file." << endl;
        return 1;
    }

    // Open destination file for writing
    ofstream destination(destinationFile);

    if (!destination)
    {
        cout << "Error opening destination file." << endl;
        return 1;
    }

    // Copy file contents
    destination << source.rdbuf();

    source.close();
    destination.close();

    cout << "File copied successfully." << endl;

    return 0;
}
