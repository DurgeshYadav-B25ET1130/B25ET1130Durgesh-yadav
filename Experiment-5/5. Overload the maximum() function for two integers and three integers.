#include <iostream>
using namespace std;

int minimum(int a, int b){
    if ( a > b) {
        return b;
    } else {
        return a;
    }
}

double minimum(double a, double b){
    if ( a > b) {
        return b;
    } else {
        return a;
    }
}

int main() {
    int int1 = 23;
    int int2 = 11;
    double float1 = 92.60;
    double float2 = 47.93;

    cout << "The minimum of " << int1 << " and " << int2 << " is: " << minimum(int1, int2) << endl;

    cout << "The minimum of " << float1 << " and " << float2 << " is: " << minimum(float1, float2) << endl;

    return 0;
}
